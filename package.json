{
  "name": "@raptor-js/kernel",
  "version": "0.30.0",
  "description": "The core of the Raptor framework: middleware, context and responses.",
  "license": "MIT",
  "homepage": "https://raptorjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raptor-js/kernel.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/benchmarks"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage 'src/**/*.test.ts'",
    "bench": "node benchmarks/in-process.ts",
    "bench:http": "node benchmarks/http.ts",
    "prepack": "npm run build",
    "bench:http:deno": "node benchmarks/http.ts deno"
  },
  "dependencies": {
    "@raptor-js/types": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@hono/node-server": "^2.1.6",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.6",
    "autocannon": "^8.0.0",
    "elysia": "^1.4.31",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "h3": "^2.0.8",
    "hono": "^4.13.16",
    "koa": "^3.3.0",
    "mitata": "^1.0.34",
    "typescript": "^7.0.2"
  }
}
